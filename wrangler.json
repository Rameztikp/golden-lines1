{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "golden-lines",
  "main": "server/cloudflare.mjs",
  "compatibility_date": "2026-10-06",
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {
    "ADMIN_OWNER_EMAIL": "rameztalal.a.h@gmail.com",
    "CF_ACCESS_TEAM_DOMAIN": "https://cool-lake-0a00.cloudflareaccess.com",
    "CF_ACCESS_AUD": "d8bf688754ca9eb9ad1daa30c429a82aa08fe3de24ae1a8aef3c566591ff7742"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "golden-lines",
      "database_id": "9b31186e-e47b-4bb2-8be0-4d18c661ffab",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "golden-lines-media"
    }
  ]
}
